<?xml version="1.0" encoding="utf-8"?>
<!-- Update GSTR-1 taxable base expressions to include gst_charge lines (P&F charges) -->
<odoo noupdate="0">
    <!-- Section 4A: B2B Regular -->
    <record id="l10n_in_reports.account_report_gstr1_b2b_regular_taxable_amount_balance" model="account.report.expression">
        <field name="formula" eval="[('l10n_in_gstr_section', '=', 'sale_b2b_regular'), ('display_type', 'in', ['product', 'gst_charge'])]"/>
    </record>
    <!-- Section 4B: B2B Reverse Charge -->
    <record id="l10n_in_reports.account_report_gstr1_b2b_reverse_charge_taxable_amount_balance" model="account.report.expression">
