        <field name="formula" eval="[('l10n_in_gstr_section', 'in', ['sale_b2b_rcm', 'sale_b2b_regular', 'sale_sez_wp', 'sale_sez_wop', 'sale_deemed_export', 'sale_cdnr_rcm', 'sale_cdnr_regular', 'sale_cdnr_deemed_export', 'sale_cdnr_sez_wp', 'sale_cdnr_sez_wop', 'sale_nil_rated', 'sale_exempt', 'sale_non_gst_supplies']), ('move_id.l10n_in_gst_treatment', 'in', ['regular', 'composition', 'uin_holders', 'special_economic_zone', 'deemed_export']), ('display_type', 'in', ['product', 'gst_charge'])]"/>
