<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add the "Active for RFQ" checkbox column to the vendor pricelist list
         shown on the product Purchase tab. -->
    <record id="product_supplierinfo_tree_view_rfq" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.active.for.rfq</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="purchase.product_supplierinfo_tree_view2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='min_qty']" position="after">
                <field name="active_for_rfq" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
